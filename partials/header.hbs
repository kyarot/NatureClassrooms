<!-- Floating Logo -->


<!-- Floating Glass Navbar -->
<header class="site-header navbar-glass" id="siteHeader">

    <div class="header-inner">

        <div class="header-brand"></div>

        <nav class="header-nav">
            <ul class="nav" id="desktopNavList"></ul>

        </nav>

        <!-- Search Button (outside nav so it's visible on mobile too) -->
        <div class="search-nav-item">
            <button class="search-toggle" id="searchToggle" aria-label="Search">
                {{> "icons/search"}}
            </button>
            <div class="search-dropdown-panel" id="searchDropdown">
                <div class="search-input-wrapper">
                    <span class="search-icon-inside">{{> "icons/search"}}</span>
                    <input type="text" class="search-input-field" id="searchInput"
                        placeholder="Search resources, blog, work..." autocomplete="off">
                </div>
                <ul class="search-results-list" id="searchResults"></ul>
            </div>
        </div>

        <!-- Hamburger Menu Button -->
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu" aria-expanded="false">
            <svg class="hamburger-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line class="hamburger-line hamburger-line-1" x1="3" y1="6" x2="21" y2="6" />
                <line class="hamburger-line hamburger-line-2" x1="3" y1="12" x2="21" y2="12" />
                <line class="hamburger-line hamburger-line-3" x1="3" y1="18" x2="21" y2="18" />
            </svg>
        </button>

    </div>

</header>

<!-- Mobile Navigation Panel -->
<div class="mobile-nav-panel" id="mobileNavPanel">
    <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
    <div class="mobile-nav-drawer">
        <div class="mobile-nav-header">
            <a href="/" class="mobile-nav-logo">
                {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                <img src="{{asset 'logo/blackmain.png'}}" alt="{{@site.title}}">
                {{/if}}
            </a>
            <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <nav class="mobile-nav">
            <ul class="nav" id="mobileNavList"></ul>
        </nav>
    </div>
</div>

<!-- Hidden Ghost Navigation Source -->
<div id="ghostNavSource" style="display: none;">
    {{navigation type="primary"}}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var source = document.getElementById('ghostNavSource');
    var desktopNav = document.getElementById('desktopNavList');
    var mobileNav = document.getElementById('mobileNavList');

    if (!source || !desktopNav || !mobileNav) return;

    var links = source.querySelectorAll('a');
    if (!links.length) return;

    var topOrder = [];
    var grouped = {};

    function ensureParent(label, href) {
        if (!grouped[label]) {
            grouped[label] = {
                label: label,
                href: href || '#',
                children: []
            };
            topOrder.push(label);
        } else if (href && grouped[label].href === '#') {
            grouped[label].href = href;
        }
    }

    links.forEach(function (link) {
        var rawLabel = (link.textContent || '').replace(/\s+/g, ' ').trim();
        var href = link.getAttribute('href') || link.href || '#';
        if (!rawLabel) return;

        if (rawLabel.indexOf('::') > -1) {
            var parts = rawLabel.split('::');
            var parentLabel = (parts[0] || '').trim();
            var childLabel = (parts.slice(1).join('::') || '').trim();

            if (!parentLabel || !childLabel) {
                ensureParent(rawLabel, href);
                return;
            }

            ensureParent(parentLabel, '#');
            grouped[parentLabel].children.push({
                label: childLabel,
                href: href
            });
            return;
        }

        ensureParent(rawLabel, href);
    });

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function renderDesktop(items) {
        return items.map(function (item) {
            if (item.children.length) {
                var childHtml = item.children.map(function (child) {
                    return '<li><a href="' + escapeHtml(child.href) + '">' + escapeHtml(child.label) + '</a></li>';
                }).join('');

                return '<li class="nav-dropdown">'
                    + '<a href="' + escapeHtml(item.href) + '" class="nav-dropdown-toggle">' + escapeHtml(item.label) + '</a>'
                    + '<ul class="nav-dropdown-menu">' + childHtml + '</ul>'
                    + '</li>';
            }

            return '<li><a href="' + escapeHtml(item.href) + '">' + escapeHtml(item.label) + '</a></li>';
        }).join('');
    }

    function renderMobile(items) {
        return items.map(function (item) {
            if (item.children.length) {
                var childHtml = item.children.map(function (child) {
                    return '<li><a href="' + escapeHtml(child.href) + '">' + escapeHtml(child.label) + '</a></li>';
                }).join('');

                return '<li class="nav-dropdown">'
                    + '<div class="mobile-nav-link-row">'
                    + '<a href="' + escapeHtml(item.href) + '" class="mobile-nav-page-link">' + escapeHtml(item.label) + '</a>'
                    + '<button class="mobile-dropdown-arrow" aria-label="Expand ' + escapeHtml(item.label) + '">▾</button>'
                    + '</div>'
                    + '<ul class="nav-dropdown-menu">' + childHtml + '</ul>'
                    + '</li>';
            }

            return '<li><a href="' + escapeHtml(item.href) + '">' + escapeHtml(item.label) + '</a></li>';
        }).join('');
    }

    var orderedItems = topOrder.map(function (label) {
        return grouped[label];
    });

    desktopNav.innerHTML = renderDesktop(orderedItems);
    mobileNav.innerHTML = renderMobile(orderedItems);
});
</script>